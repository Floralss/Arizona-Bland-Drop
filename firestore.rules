rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner() {
      return signedIn() && request.auth.token.email == 'strepoomich27@gmail.com';
    }
    function isStaff() {
      return isOwner() ||
        (signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'worker']);
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
      allow write: if isOwner();
    }

    match /profiles/{email} {
      allow read: if signedIn();
      allow create, update: if signedIn();
    }

    match /counters/{id} {
      allow read, write: if signedIn();
    }

    match /orders/{id} {
      allow create: if signedIn();
      allow read, update: if isStaff();
    }

    match /liveDrops/{id} {
      allow read: if true;
      allow create: if signedIn();
    }

    match /presence/{id} {
      allow read, write: if true;
    }
  }
}
